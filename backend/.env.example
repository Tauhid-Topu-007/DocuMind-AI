APP_NAME=DocuMind AI
APP_ENV=development
PORT=8000

# ---- AI provider: ollama | groq ----
AI_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:latest
OLLAMA_FALLBACK_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=mxbai-embed-large:latest

# Groq (cloud). Use a model ID from https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=
# If the selected provider is down, try the other one (when configured)
FALLBACK_ENABLED=false

# ---- Embeddings: ollama | fastembed ----
EMBEDDING_PROVIDER=ollama
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- Vector DB: chroma | qdrant ----
VECTOR_DB=chroma
CHROMA_PERSIST_DIRECTORY=./storage/chroma
QDRANT_URL=
QDRANT_API_KEY=

# ---- Metadata DB ----
# Leave MONGODB_URI empty in development to use a local JSON file (./storage/db.json).
# REQUIRED when APP_ENV=production.
MONGODB_URI=
DATABASE_NAME=documind
JSON_DB_PATH=./storage/db.json

# ---- Storage ----
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=20

# ---- RAG ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# ---- Security ----
SECRET_KEY=replace-with-a-strong-random-secret
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173
